                {
                    "label": "No.",
                    "message": "Proceed with the validated system process.",
                    "actions": [ "log_and_time", "require_justification" ],
                    "next_node_from_selected_values": true
                },
                {
                    "label": "Unsure.",
                    "message": "Let us find out!",
                    "actions": [ "log_and_time", "require_justification" ],
                    "next": "3_unsure_followup"
                }
            ]
        },

            "3_unsure_followup": {
                "type": "decision",
                "question": "I am unsure whether my system exhibits adaptiveness after deployment.",
                "explanation": "unsure_adaptiveness.md",
                "options": [
                    {
                        "label": "Option 1: I assume the system exhibits adaptiveness after deployment (recommended).",
                        "actions": [ "log_and_time", "require_justification" ],
                        "next_node_from_selected_values": true
                    },
                    {
                        "label": "Option 2: I assume the system does not exhibit adaptiveness after deployment.",
                        "actions": [ "log_and_time", "require_justification" ],
                        "next_node_from_selected_values": true
                    }
                ]
            },

        "4": {
            "type": "decision",
            "question": "Is your system designed to operate according to one or more implicit or explicit objectives?",
            "explanation": "objectives_explanation.md",
            "options": [
                {
                    "label": "Yes",
                    "message": "Proceed with the validated system process.",
