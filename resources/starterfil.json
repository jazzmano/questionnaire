            "5_unsure_followup": {
                "type": "decision",
                "question": "I am unsure whether my system infers, from the input it receives, how to generate outputs.",
                "explanation": "unsure_inference.md",
                "options": [
                    {
                        "label": "Option 1: I assume the system infers, from the input it receives, how to generate outputs (recommended).",
                        "actions": [ "log_and_time", "require_justification" ],
