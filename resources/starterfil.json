                "question": "I am unsure whether my system is designed to operate according to one or more implicit or explicit objectives.",
                "explanation": "unsure_objectives.md",
                "options": [
                    {
                        "label": "Option 1: I assume the system is designed to operate according to one or more implicit or explicit objectives (recommended).",
                        "actions": [ "log_and_time", "require_justification" ],
