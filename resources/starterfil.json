{
    "entry": "introduction",
    "nodes": {
        "introduction": {
            "type": "start",
            "message": "Welcome to the AI System Assessment Tool! This tool will help you determine if your IT system qualifies as an AI system under the EU AI Act.",
            "explanation": "decision_flow_explanation.md",
            "next": "identification"
        },
        "identification": {
            "type": "decision",
            "message": "Please provide your identification details to complete the assessment.",
            "questions": [
                {
                    "Name": "Please type in your name.",
                    "E-mail": "Please provide your e-mail address.",
                    "Company": "Please provide the name of the company you represent.",
                    "System": "Please provide the name of the exact system (including, if applicable, the system version), you are assessing."
                }
            ],
            "explanation": "identification.md",
            "options": [
                {
                    "next": "0"
            }
            ]
        },

        "0": {
            "type": "decision",
            "question": "Is your system an AI system according to Article 3(1) of the AI Act?",
            "explanation": "AI_system_explanation.md",
            "options": [
                {
                    "label": "Yes.",
                    "actions": ["log_and_time","require_justification"],
                    "next": "your_system_is_an_AI_system"
                },
                {
                    "label": "No.",
                    "actions": ["log_and_time","require_justification"],
                    "next": "not_subject_to_the_AI_Act"
                },
                {
                    "label": "Don't know. (Justification not required)",
                    "actions": ["log_and_time"],
                    "next": "unsure_followup"
                }
            ]
        },

        "unsure_followup": {
            "type": "decision",
            "question": "What parts are you unsure about (you can select more)?",
            "explanation": "unsure_AI_system_explanation.md",
            "options": [
                {
                    "label": "I don't know what I don't know – take me through everything.",
                    "actions": ["log_and_time"],
                    "all_values": ["1", "2", "3", "4", "5", "6", "7"],
                    "value": "0"
                },
                {
                    "label": "I don't know if I fulfill the 'machine-based system' criteria.",
                    "actions": ["log_and_time"],
                    "value": "1"
                },
                {
                    "label": "I don't know if my system has the necessary level of autonomy.",
                    "actions": ["log_and_time"],
                    "value": "2"
                },
                {
                    "label": "I don't know whether my system can adapt/learn after use.",
                    "actions": ["log_and_time"],
                    "value": "3"
                },
                {
                    "label": "I don't know if the AI system is designed to operate according to one or more objectives.",
                    "actions": ["log_and_time"],
                    "value": "4"
                },
                {
                    "label": "I don't know if the system has inference capability.",
                    "actions": ["log_and_time"],
                    "value": "5"
                },
                {
                    "label": "I don't know if the system can generate outputs.",
                    "actions": ["log_and_time"],
                    "value": "6"
                },
                {
                    "label": "I don't know if the system can influence physical or virtual environments.",
                    "actions": ["log_and_time"],
                    "value": "7"
                }
            ],

            "routing": {
                "action": "log_and_time",
                "next_nodes_from_selected_values": true,
                "next_node_when_selected_values_empty": "your_system_is_an_AI_system"
            }
        },

        "1": {
            "type": "decision",
            "question": "Is your IT system a machine-based system?",
            "explanation": "machine_based_system_explanation.md",
            "options": [
                {
                    "label": "Yes.",
                    "message": "Proceed with the validated system process.",
                    "actions": [ "log_and_time", "require_justification" ],
                    "next_node_from_selected_values": true
                },
                {
                    "label": "No.",
                    "message": "If your system is not machine-based, it is not an AI-system.",
                    "actions": [ "log_and_time", "require_justification" ],
                    "next_node_from_selected_values": true
                },
                {
                    "label": "Unsure.",
                    "message": "Let us find out!",
                    "actions": [ "log_and_time", "require_justification" ],
                    "next": "1_unsure_followup"
                }
            ]
        },

            "1_unsure_followup": {
                "type": "decision",
                "question": "I am unsure whether my system is machine-based.",
                "explanation": "unsure_machine_based_explanation.md",
                "options": [
                    {
                        "label": "Option 1: I assume the system is machine-based (recommended).",
                        "actions": [ "log_and_time", "require_justification" ],
                        "next_node_from_selected_values": true
                    },
                    {
                        "label": "Option 2: I assume the system is not machine-based.",
                        "actions": [ "log_and_time", "require_justification" ],
                        "next": "not_subject_to_the_AI_Act"
                    }
                ]
            },

        "2": {
            "type": "decision",
            "question": "Is your IT system designed to operate with a varying level of autonomy?",
            "explanation": "autonomy_explanation.md",
            "options": [
                {
                    "label": "Yes.",
                    "message": "Proceed with the validated system process.",
                    "actions": [ "log_and_time", "require_justification" ],
                    "next_node_from_selected_values": true
                },
                {
                    "label": "No.",
                    "message": "If your system is not designed to operate with a varying level of autonomy, it is not an AI-system.",
                    "actions": [ "log_and_time", "require_justification" ],
                    "next": "not_subject_to_the_AI_Act"
                },
                {
                    "label": "Unsure.",
                    "message": "Let us find out!",
                    "actions": [ "log_and_time", "require_justification" ],
                    "next": "2_unsure_followup"
                }
            ]
        },

            "2_unsure_followup": {
                "type": "decision",
                "question": "I am unsure whether my system operates with a level of autonomy.",
                "explanation": "unsure_autonomy.md",
                "options": [
                    {
                        "label": "Option 1: I assume the system is designed to operate with varying levels of autonomy (recommended).",
                        "actions": [ "log_and_time", "require_justification" ],
                        "next_node_from_selected_values": true
                    },
                    {
                        "label": "Option 2: I assume the system is not designed to operate with varying levels of autonomy.",
                        "actions": [ "log_and_time", "require_justification" ],
                        "next": "not_subject_to_the_AI_Act"
                    }
                ]
            },

        "3": {
            "type": "decision",
            "question": "Is your IT system able to exhihibit adaptiveness after deployment?",
